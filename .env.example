# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube a GitHub. Estos mismos valores se cargan en Vercel
# (proyecto → Settings → Environment Variables) y luego se vuelve a desplegar.

# Clave de API de Google Cloud, restringida solo a "Places API (New)"
GOOGLE_PLACES_API_KEY=

# Place ID de la ficha de Google (empieza con "ChIJ")
# Se obtiene con el "Place ID Finder" de Google Maps Platform
GOOGLE_PLACE_ID=

# Medición (opcional). Sin estos valores no se carga ninguna herramienta ni aparece el aviso de cookies.
# ID de Google Analytics 4, empieza con "G-"
NEXT_PUBLIC_GA_ID=
# ID de proyecto de Microsoft Clarity (texto corto de letras y números)
NEXT_PUBLIC_CLARITY_ID=

# Contador de visitas (opcional). Vercel las crea sola al conectar Upstash Redis desde Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Traducción al español de los formularios en inglés y alemán (opcional).
# Clave de API de Google Cloud restringida a "Cloud Translation API".
# Sin ella, el mensaje se envía solo con el texto original.
GOOGLE_TRANSLATE_API_KEY=

# Captcha del formulario: Cloudflare Turnstile (gratis). Se crea en dash.cloudflare.com → Turnstile → Add widget.
# La clave del sitio es pública (se ve en el código de la página); la clave secreta NO.
# Sin ellas, el formulario funciona sin captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Consulta del uso de APIs en /uso. Texto largo y aleatorio (mínimo 16 caracteres). Sin él, /uso no funciona.
USO_API_TOKEN=

# Tope mensual de caracteres a traducir (opcional; por defecto 400000). Google entrega 500000 gratis al mes.
LIMITE_TRADUCCION_CARACTERES_MES=
